# Copy this file to .env.local and fill in what you need.
# .env.local is git-ignored, so everyone can have their own values and secrets
# never reach the repository.

# --- WoW install -------------------------------------------------------------
# The AddOns directory itself, NOT the PalAddIn folder inside it. The install
# script creates or refreshes the PalAddIn folder under it.
#
# Optional: scripts\install.ps1 auto-detects the usual locations, so you only
# need this if WoW lives somewhere unusual.

WOW_ADDONS_DIR=C:\Program Files (x86)\World of Warcraft\_anniversary_\Interface\AddOns

# --- OpenAI image generation -------------------------------------------------
# Used by scripts\New-Image.ps1 to generate icons and illustrations.
# OPEN_AI_API_KEY is accepted as an alias, and $env:OPENAI_API_KEY wins over
# both if it is set.
#
# Generating images costs money. Keep this key out of any file that is not
# .env.local, and never paste it into a commit, an issue, or a chat log.

OPENAI_API_KEY=sk-...
