# Copy this file to .env.local and adjust the path.
# .env.local is git-ignored, so everyone can have their own install location.
#
# This must be the AddOns directory itself, NOT the PalAddIn folder inside it.
# The install script creates or refreshes the PalAddIn folder under it.
#
# If your WoW lives in one of the usual places, you can skip this entirely —
# scripts/install.ps1 auto-detects those.

WOW_ADDONS_DIR=C:\Program Files (x86)\World of Warcraft\_anniversary_\Interface\AddOns
